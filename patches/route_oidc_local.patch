+from onelogin.saml2.auth import OneLogin_Saml2_Auth
+
+_UNIVERSITY_MAP = {
+    "aaa": {"credential_configuration_id": "jp.ac.aaa-university.student_id", "university_name": "AAA University"},
+    "bbb": {"credential_configuration_id": "jp.ac.bbb-university.student_id", "university_name": "BBB University"},
+    "ccc": {"credential_configuration_id": "jp.ac.ccc-university.student_id", "university_name": "CCC University"},
+}
+
+
+def _saml_settings() -> dict:
+    sp_entity_id = os.environ.get("SAML_SP_ENTITY_ID", cfgservice.service_url.rstrip("/"))
+    acs_url = os.environ.get("SAML_SP_ACS_URL", cfgservice.service_url.rstrip("/") + "/saml/acs")
+    idp_sso_url = os.environ.get("SAML_IDP_SSO_URL", "http://localhost:4000/sso")
+    idp_entity_id = os.environ.get("SAML_IDP_ENTITY_ID", "http://localhost:4000")
+    idp_cert = os.environ.get("SAML_IDP_CERT", "")
+    return {
+        "strict": True,
+        "debug": False,
+        "sp": {
+            "entityId": sp_entity_id,
+            "assertionConsumerService": {
+                "url": acs_url,
+                "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
+            },
+            "NameIDFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
+            "x509cert": "",
+            "privateKey": "",
+        },
+        "idp": {
+            "entityId": idp_entity_id,
+            "singleSignOnService": {
+                "url": idp_sso_url,
+                "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
+            },
+            "x509cert": idp_cert,
+        },
+        "security": {
+            "wantAssertionsSigned": False,
+            "wantMessagesSigned": True,
+            "signatureAlgorithm": "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256",
+            "digestAlgorithm": "http://www.w3.org/2001/04/xmlenc#sha256",
+        },
+    }
+
+
+def _prepare_saml_request(req) -> dict:
+    return {
+        "https": "on" if req.scheme == "https" else "off",
+        "http_host": req.host,
+        "script_name": req.path,
+        "get_data": req.args.copy(),
+        "post_data": req.form.copy(),
+        "query_string": req.query_string,
+    }
+
+
+@oidc.route("/saml/login", methods=["GET"])
+def saml_login():
+    auth = OneLogin_Saml2_Auth(_prepare_saml_request(request), old_settings=_saml_settings())
+    return redirect(auth.login())
+
+
+@oidc.route("/saml/acs", methods=["POST"])
+def saml_acs():
+    auth = OneLogin_Saml2_Auth(_prepare_saml_request(request), old_settings=_saml_settings())
+    auth.process_response()
+    errors = auth.get_errors()
+    if errors:
+        reason = auth.get_last_error_reason()
+        return jsonify({"error": f"SAML validation failed: {errors}", "reason": reason}), 400
+    if not auth.is_authenticated():
+        return jsonify({"error": "SAML authentication failed"}), 401
+
+    raw_attrs = auth.get_attributes()
+    # python3-saml returns dict of lists; flatten to single values
+    attrs = {k: v[0] if isinstance(v, list) and v else v for k, v in raw_attrs.items()}
+
+    given_name = attrs.get("firstName", "")
+    family_name = attrs.get("lastName", "")
+    email = attrs.get("email", "")
+    enrollment_year = attrs.get("enrollment_year", "")
+    university_key = attrs.get("university", "")
+
+    mapped = _UNIVERSITY_MAP.get(university_key, {})
+    credential_configuration_id = mapped.get("credential_configuration_id", "")
+    university_name = mapped.get("university_name", "")
+
+    if not credential_configuration_id:
+        return jsonify({"error": f"Unknown university: {university_key!r}"}), 400
+
+    session_id = generate_unique_id()
+    extra = {
+        "given_name": given_name,
+        "family_name": family_name,
+        "email": email,
+        "enrollment_year": enrollment_year,
+        "university_name": university_name,
+    }
+    session_manager.add_session(session_id=session_id, user_data={"extra": extra})
+
+    credential_issuer = cfgservice.service_url.rstrip("/")
+    credential_offer = {
+        "credential_issuer": credential_issuer,
+        "credential_configuration_ids": [credential_configuration_id],
+        "grants": {"authorization_code": {"issuer_state": session_id}},
+    }
+    json_string = json.dumps(credential_offer)
+    uri = (
+        f"{cfgservice.credential_offer_scheme}credential_offer"
+        f"?credential_offer={urllib.parse.quote(json_string, safe=':/')}"
+    )
+
+    qrcode = segno.make(uri)
+    out = io.BytesIO()
+    qrcode.save(out, kind="png", scale=5)
+    qr_img_base64 = base64.b64encode(out.getvalue()).decode("utf-8")
+
+    cfgservice.app_logger.info(
+        f"SAML ACS: session_id={session_id}, credential={credential_configuration_id}"
+    )
+
+    html = f"""<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>University Student Credential</title>
+  <style>
+    body {{ font-family: sans-serif; text-align: center; padding: 2rem; max-width: 480px; margin: 0 auto; }}
+    img {{ max-width: 300px; margin: 1rem auto; display: block; border: 1px solid #ddd; }}
+    .uri {{ font-size: .75rem; word-break: break-all; color: #666; }}
+    .open-wallet {{
+      display: inline-block; margin-top: 12px; padding: 10px 24px;
+      font-size: 16px; background: #0070f3; color: white;
+      border-radius: 6px; text-decoration: none;
+    }}
+  </style>
+</head>
+<body>
+  <h2>Scan with your wallet</h2>
+  <p>{given_name} {family_name} — {university_name}</p>
+  <img src="data:image/png;base64,{qr_img_base64}" alt="QR Code"/>
+  <p class="uri">{uri}</p>
+  <a href="{uri}" class="open-wallet">Open Wallet</a>
+</body>
+</html>"""
+    return make_response(html, 200)
