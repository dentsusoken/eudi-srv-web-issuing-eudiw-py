# Flask TLS Options (set cert/key paths for local TLS, leave empty for cloud)
FLASK_TLS_OPTS=--cert=/certs/tls/localhost+2.pem --key=/certs/tls/localhost+2-key.pem

# Service Configuration
SERVICE_URL=https://localhost:5001/
WALLET_TEST_URL=https://dev.tester.issuer.eudiw.dev/

# Frontend
DEFAULT_FRONTEND=5d725b3c-6d42-448e-8bfd-1eff1fcf152d
DEFAULT_FRONTEND_URL=https://localhost:6007
# Paths
TRUSTED_CAS_PATH=/etc/eudiw/pid-issuer-dev/cert/
PRIVKEY_PATH=/etc/eudiw/pid-issuer-dev/privKey/

# Keys (update paths for your environment)
NONCE_KEY=/etc/eudiw/pid-issuer-dev/privKey/nonce_rsa2048.pem
CREDENTIAL_KEY=/etc/eudiw/pid-issuer-dev/privKey/credential_request.pem

# Internal Services
AUTH_SERVER_INTERNAL_URL=https://host.docker.internal:6005
#AUTH_SERVER_INTERNAL_URL=http://127.0.0.1:6005
VERIFY_USER_ENDPOINT=https://localhost:6005/verify/user

# External Services
DYNAMIC_PRESENTATION_URL=https://dev.verifier-backend.eudiw.dev/ui/presentations/

REVOCATION_API_KEY=testtest
REVOCATION_SERVICE_URL=https://issuer.eudiw.dev/token_status_list/take
REVOKE_SERVICE_URL=https://issuer.eudiw.dev/token_status_list/set

OID4VP_SCHEME=haip-vp://
CREDENTIAL_OFFER_SCHEME=haip-vci://

EIDAS_NODE_CONNECTOR_URL=https://eidas.projj.eu
EIDAS_NODE_CLIENT_ID=example
EIDAS_NODE_CLIENT_SECRET=example

PT_CLIENT_ID=example
PT_CLIENT_SECRET=example

EE_CLIENT_ID=example
EE_BASIC_AUTHORIZATION_HEADER=Basic example

EE_REDIRECT_URI=https://pprpid.provider.eudiw.projj.eu/tara/redirect

#Issuer Back-end log file
LOG_FILE=/tmp/log_dev/logs.log

#Authorization server log file for /logs endpoint
AUTH_LOG_FILE=/tmp/oidc_log_dev/logs.log

# SAML SP
SAML_IDP_ENTITY_ID=http://localhost:4000
SAML_IDP_SSO_URL=http://localhost:4000/sso
SAML_SP_ENTITY_ID=https://localhost:5001
SAML_SP_ACS_URL=https://localhost:5001/saml/acs
# Base64 DER cert printed by univ-mock-idp on startup (update after re-running setup.sh)
SAML_IDP_